  "scripts": {
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "postinstall": "node scripts/generate-build-info.mjs",
    "prestart:tratt": "node scripts/generate-build-info.mjs",
    "prebuild": "node scripts/generate-build-info.mjs",
    "prebuild:dev": "node scripts/generate-build-info.mjs",
    "prebuild:prod": "node scripts/generate-build-info.mjs",
    "prebuild:beta": "node scripts/generate-build-info.mjs",
    "prebuild:prod:beta": "node scripts/generate-build-info.mjs",
    "prebuild:release": "node scripts/generate-build-info.mjs",
    "start": "npm run start:tratt",
    "start:tratt": "nx serve tratt --host 0.0.0.0 --disable-host-check",
    "start:json-sets-demo": "nx serve json-sets-demo",
    "build": "nx build tratt",
    "build:docs": "typedoc --out typedocs && node runner.js prepare:docs",
    "build:release": "node runner.js build:release",
    "build:dev": "node runner.js build:dev",
    "build:beta": "node runner.js build:beta",
    "build:prod:beta": "node runner.js build:prod:beta",
    "build:prod": "node runner.js build:prod",
    "build:libs": "node runner.js build:libs",
    "build:extern": "node runner.js build:extern",
    "build:json-sets": "node runner.js build:json-sets",
    "build:assets": "node runner.js build:assets",
    "build:web-components": "nx build ngx-components && nx build web-components --outputHashing none && node prepare_web-components.js && node scripts/optimize-web-components.js",
    "build:watch:deploy": "nx build tratt --configuration=public-development --base-href=/apps/octra/tratt-dev/ --outputPath ./deploy --watch",
    "build:dev:update:beta": "node runner.js build:dev:update:beta",
    "build:prod:update:beta": "node runner.js build:prod:update:beta",
    "build:prod:update": "node runner.js build:prod:update",
    "deploy:octra:dev:beta": "npm run build:dev:update:beta && npm run package:octra:dev && ./deploy.sh tratt-2-dev",
    "package:octra:dev": "cd dist/apps && rm -f tratt-2-dev.zip 2> /dev/null && zip -q -r tratt-2-dev.zip octra && cd -",
    "deploy:octra:prod:beta": "npm run build:prod:update:beta && npm run package:octra:prod && ./deploy.sh tratt-2",
    "deploy:octra:prod": "npm run build:prod:update && npm run package:octra:prod && ./deploy.sh tratt-2",
    "package:octra:prod": "cd dist/apps && rm -f tratt-2.zip 2> /dev/null && zip -q -r tratt-2.zip octra && cd -",
    "release:app:tratt": "npm run build:release && nx run tratt:version --push",
    "release:lib:annotation": "node runner.js build:lib annotation && nx run annotation:version --push",
    "publish:lib:annotation": "node runner.js build:lib annotation && nx npm annotation",
    "release:lib:assets": "node runner.js build:assets && nx run assets:version --releaseAs=patch --push",
    "publish:lib:assets": "node runner.js build:assets && nx npm assets",
    "release:lib:json-sets": "node runner.js build:lib json-sets && nx run json-sets:version --push",
    "publish:lib:json-sets": "node runner.js build:lib json-sets && nx npm json-sets",
    "release:lib:media": "node runner.js build:lib media && nx run media:version --push",
    "publish:lib:media": "node runner.js build:lib media && nx npm media",
    "release:lib:ngx-components": "node runner.js build:lib ngx-components && nx run ngx-components:version --push",
    "publish:lib:ngx-components": "node runner.js build:lib ngx-components && nx npm ngx-components",
    "release:lib:ngx-utilities": "node runner.js build:lib ngx-utilities && nx run ngx-utilities:version --push",
    "publish:lib:ngx-utilities": "node runner.js build:lib ngx-utilities && nx npm ngx-utilities",
    "release:lib:utilities": "node runner.js build:lib utilities && nx run utilities:version --push",
    "publish:lib:utilities": "node runner.js build:lib utilities && nx npm utilities",
    "release:lib:web-media": "node runner.js build:lib web-media && nx run web-media:version --push",
    "publish:lib:web-media": "node runner.js build:lib web-media && nx npm web-media",
    "analyze:tratt": "nx build tratt --configuration production --stats-json && webpack-bundle-analyzer dist/apps/tratt/stats.json",
    "validate:i18n": "node apps/tratt/scripts/validate-i18n.js",
    "validate:manual": "node scripts/check-manual-links.mjs",
    "build:manual": "node scripts/build-manual.mjs",
    "lint": "nx lint tratt",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "migrate": "npx nx migrate --run-migrations",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "test": "nx test tratt",
    "modernizr": "modernizr -d apps/tratt/src/assets/js/modernizr.js -c ./apps/tratt/src/modernizr.json",
    "workspace-generator": "nx workspace-generator",
    "update-browserlist": "npx browserslist@latest --update-db",
    "nx:add": "nx generate ng-add"
  },
